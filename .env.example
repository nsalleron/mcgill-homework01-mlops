# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Webhook (optional — leave empty to skip)
WEBHOOK_URL=

# API — which model run to load (set after training)
MODEL_RUN_ID=

# Training overrides (optional, defaults in config/training.toml)
# EPOCHS=10
# BATCH_SIZE=64
# LEARNING_RATE=0.001
# OPTIMIZER=adam
# LOSS_FN=cross_entropy
# SEED=42
# VAL_SPLIT=0.1
