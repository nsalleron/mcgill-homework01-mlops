FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml .
COPY src/ui/ src/ui/

RUN uv pip install --system --no-cache \
    streamlit httpx pillow pandas

ENV PYTHONPATH=/app

EXPOSE 8501
CMD ["streamlit", "run", "src/ui/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
